# Extension build settings. Values here override the web wallet's .env
# (the repo-root .env is read first for DOK_WALLET_BASE_URL, BREEZ_API_KEY,
# the WalletConnect ids, ...). Copy to extension/.env; never commit it.

# Brand to build: dokwallet (default) or kimlwallet. Can also be passed as
# BRAND=kimlwallet yarn ext:build   (same as yarn ext:build:kiml)
# BRAND=dokwallet

# x-app-name suffix sent to DokApi: "<brand>-<suffix>". The backend must
# accept it without a reCAPTCHA token (see README, "Backend changes").
# EXT_APP_NAME_SUFFIX=extension

# Google Drive backup/restore: a "Web application" OAuth client in the SAME
# Google Cloud project as the brand's mobile app, with the authorised
# redirect URI https://<extension-id>.chromiumapp.org/
DOK_WALLET_GOOGLE_EXTENSION_CLIENT_ID=
KIML_WALLET_GOOGLE_EXTENSION_CLIENT_ID=

# Mixed into the backup encryption key. Must equal the mobile app's and the
# web server's WALLET_BACKUP_SECRET. It ships inside the extension, as it
# ships inside the mobile app.
WALLET_BACKUP_SECRET=
DOKWALLET_WALLET_CONNECT_ID=3720c3c53189db17acc86488cd67902c
KIMLWALLET_WALLET_CONNECT_ID=e24f8c9f4a07bd018a3199f3e93cd551

# Optional: a deployed web wallet's Electrum bridge, e.g.
# https://www.dokwallet.app/api/bitcoin . Without it Bitcoin data comes from
# the DokApi backend (the web wallet's existing fallback).
# ELECTRUM_BRIDGE_URL=

# Optional: pin the extension id in development (public key from the Chrome
# Web Store dashboard, or generated locally) so the OAuth redirect URI stays
# the same across machines.
# EXTENSION_KEY=
