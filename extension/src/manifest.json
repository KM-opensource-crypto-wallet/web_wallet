{
  "manifest_version": 3,
  "name": "__BRAND_NAME__",
  "version": "__VERSION__",
  "description": "__BRAND_DESCRIPTION__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__BRAND_NAME__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "app.html?surface=sidepanel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "sidePanel", "identity", "contextMenus"],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
